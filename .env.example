# Copiez ce fichier en .env puis complétez. Ne commitez jamais .env.

# --- Claude (Anthropic) ---
# "simule" : aucun appel, réponses déterministes marquées [simulé] (développement, tests, démos)
# "anthropic" : vrais appels à Claude (nécessite la clé)
LLM_MODE=simule
ANTHROPIC_API_KEY=
MODELE_FORT=claude-sonnet-5-5
MODELE_LEGER=claude-haiku-4-5-20251001
SEUIL_CONFIANCE=0.7

# --- API ---
# SQLite par défaut (rien à installer). Pour PostgreSQL (docker compose) :
# DATABASE_URL=postgresql+psycopg://ideomes:ideomes@localhost:5432/ideomes
PROPRIETAIRE_UID=owner
API_JETON_SERVICE=changez-moi
PIPELINE_AUTO=true
API_URL=http://localhost:8000
